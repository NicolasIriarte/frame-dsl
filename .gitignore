# The Forgejo token is linked in by `bytewise --conf-repo .' and is also excluded through
# .git/info/exclude. Listed here too so a clone set up by hand cannot commit it either.
/.env.forgejo

# Build output. The vendored CLibs tarballs are unpacked in here too, so this covers them.
/build/
/.cache/

# Generated by `make` for language servers. Holds absolute paths, so it is specific to one machine
# and belongs to nobody else's checkout.
/compile_commands.json
