#compdef frame-dsl
#
# zsh completion for frame-dsl (#85).
#
# Installed by `make install` to $(PREFIX)/share/zsh/site-functions/_frame-dsl. That directory is on
# zsh's default $fpath for /usr and /usr/local; for another PREFIX, add it before `compinit`:
#
#   fpath=(~/.local/share/zsh/site-functions $fpath)
#
# The same answers as completions/frame-dsl.bash, from the same place: the flags from `frame-dsl
# --help` when <TAB> is pressed, packet and field names from `--list-packets` and `--list-fields`.

# The option lines of --help, as "flag takes-argument" pairs: `-e 1`, `--encode 1`, `--check 0`.
_frame-dsl_flags() {
  _call_program flags "${(q)1}" --help 2>/dev/null | awk '
    /^options:/ { taking = 1; next }
    /^$/        { taking = 0 }
    taking {
      n = 0
      for (i = 1; i <= NF; i++) {
        word = $i
        sub(/,$/, "", word)
        if (word ~ /^-/) { flags[++n] = word; continue }
        takes = word ~ /^</
        break
      }
      for (j = 1; j <= n; j++) print flags[j], takes
    }
  '
}

_frame-dsl() {
  local program=${words[1]/#\~/$HOME}
  local previous=${words[CURRENT-1]}
  local definition= packet= word flag takes i
  local -A takes_argument
  local -a flags names given

  for flag takes in ${=$(_frame-dsl_flags $program)}; do
    takes_argument[$flag]=$takes
    flags+=($flag)
  done

  # The definition file and the -e packet already on the line; a flag's argument is skipped, so the
  # hex after -d is never taken for a file.
  for (( i = 2; i < CURRENT; i++ )); do
    word=${words[i]}
    if [[ ${takes_argument[$word]:-0} == 1 ]]; then
      [[ $word == (-e|--encode) ]] && packet=${words[i+1]}
      (( i++ ))
    elif [[ $word != -* && $word != *=* && -z $definition ]]; then
      definition=${word/#\~/$HOME}
    fi
  done

  case $previous in
    (-e|--encode|--list-fields)
      [[ -n $definition && $definition != - ]] || return 1
      names=(${(f)"$(_call_program packets "${(q)program}" "${(q)definition}" --list-packets 2>/dev/null)"})
      compadd -a names
      return
      ;;
    (--stdin-name)
      _files
      return
      ;;
  esac
  # Any other flag that takes an argument (-d's hex) has nothing worth offering.
  [[ ${takes_argument[$previous]:-0} == 1 ]] && return 1

  if [[ $PREFIX == -* ]]; then
    compadd -a flags
    return
  fi

  # After `-e PACKET`, the packet's fields as `name=`, leaving out the ones already given.
  if [[ -n $packet && -n $definition && $definition != - ]]; then
    names=(${(f)"$(_call_program fields "${(q)program}" "${(q)definition}" --list-fields "${(q)packet}" 2>/dev/null)"})
    given=(${${(M)words[2,CURRENT-1]:#*=*}%%=*})
    names=(${names:|given})
    compadd -S '=' -a names
    return
  fi

  # Otherwise a definition file: .fdsl files, and directories to find one in.
  _files -g '*.fdsl(-.)'
}

_frame-dsl "$@"
