#compdef frame-dsl
#
# zsh completion for frame-dsl (#85).
#
# Installed by `make install` to $(PREFIX)/share/zsh/site-functions/_frame-dsl. That directory is on
# zsh's default $fpath for /usr and /usr/local; for another PREFIX, add it before `compinit`:
#
#   fpath=(~/.local/share/zsh/site-functions $fpath)
#
# The same answers as completions/frame-dsl.bash, from the same place: the flags from `frame-dsl
# --help` when <TAB> is pressed. No flag takes a packet or a field name since encoding left the command
# line (#97).

# The option lines of --help, as "flag takes-argument" pairs: `-d 1`, `--decode 1`, `--check 0`.
_frame-dsl_flags() {
  _call_program flags "${(q)1}" --help 2>/dev/null | awk '
    /^options:/ { taking = 1; next }
    /^$/        { taking = 0 }
    taking {
      n = 0
      for (i = 1; i <= NF; i++) {
        word = $i
        sub(/,$/, "", word)
        if (word ~ /^-/) { flags[++n] = word; continue }
        takes = word ~ /^</
        break
      }
      for (j = 1; j <= n; j++) print flags[j], takes
    }
  '
}

_frame-dsl() {
  local program=${words[1]/#\~/$HOME}
  local previous=${words[CURRENT-1]}
  local flag takes
  local -A takes_argument
  local -a flags

  for flag takes in ${=$(_frame-dsl_flags $program)}; do
    takes_argument[$flag]=$takes
    flags+=($flag)
  done

  if [[ $previous == --stdin-name ]]; then
    _files
    return
  fi
  if [[ $previous == --packet ]]; then
    local word
    local -a packets
    for word in ${words[2,-1]}; do
      if [[ $word == *.fdsl && -f $word ]]; then
        packets=(${(f)"$($program $word --list-packets 2>/dev/null)"})
        break
      fi
    done
    compadd -a packets
    return
  fi
  # Any other flag that takes an argument (-d's hex) has nothing worth offering.
  [[ ${takes_argument[$previous]:-0} == 1 ]] && return 1

  if [[ $PREFIX == -* ]]; then
    compadd -a flags
    return
  fi

  # Otherwise a definition file: .fdsl files, and directories to find one in.
  _files -g '*.fdsl(-.)'
}

_frame-dsl "$@"
