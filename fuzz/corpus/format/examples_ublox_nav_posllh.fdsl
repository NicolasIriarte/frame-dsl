# UBX-NAV-POSLLH, a position message from a u-blox GNSS receiver: a real serial frame, with its id in its
# bytes. From the u-blox receiver protocol description.
#
# Sync characters, class and id identify the packet, so it needs no help from a program. Latitude and
# longitude are signed, in units of 1e-7 degrees, and everything is little-endian.
#
# `ck_a` and `ck_b` are a Fletcher checksum over everything from `class` on. They stay plain fields: the
# program computes and checks them, and a test can send a wrong one.
#
#   frame-dsl ublox_nav_posllh.fdsl -d "B5 62 01 02 1C 00 A0 86 01 00 00 DE 30 DD 80 75 60 EB
#                                       A8 61 00 00 E0 2E 00 00 DC 05 00 00 C4 09 00 00 36 76"

@byte_order: little_endian;

cal degrees(raw) = raw * 1e-7;

pkt NAV_POSLLH {
  sync1:  8  := 0xB5;
  sync2:  8  := 0x62;
  class:  8  := 0x01;
  id:     8  := 0x02;
  length: 16 := 28;
  itow:   32;
  [ @cal: degrees; ]
  lon:    i32;
  [ @cal: degrees; ]
  lat:    i32;
  height: i32;
  hmsl:   i32;
  hacc:   32;
  vacc:   32;
  ck_a:   8;
  ck_b:   8;
};
