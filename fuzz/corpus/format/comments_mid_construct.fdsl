block Header { id: 8; flags: 4; rest: 4; };
pkt TM { # opening
  id: 8 # mid-field
    := 1;
  hdr: Header { # in overrides
    flags := 2;
    # alone in overrides
    rest := 1; };
  [ # after bracket
    @byte_order: little_endian;
    # before close bracket
  ]
  v: 16;
  # before close brace
}; # after close
