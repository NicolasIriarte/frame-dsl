# REJECTED: check 17 -- calibration names are unique in a file.
#
# Two curves called `volts` would leave `@cal: volts;` meaning whichever one the reader happened to
# look at first.

cal volts(raw) = raw * 3.3 / 4095;
cal volts(raw) = raw * 5.0 / 4095;

pkt TM_ADC {
  id: 8 := 0x01;
  [ @cal: volts; ]
  reading: 16;
};
