# REJECTED: check 10 -- fields that share a byte must agree on @byte_order.
#
# `seq` is little-endian and `tail` is not. Big-endian fields fill a byte from the top and little-endian
# ones from the bottom, so the two would overlap in the byte they share. Writing the order on `tail` as
# well, or on a block around both, is what this most likely meant.
#
# A change of order on a byte boundary is not a mistake: `hdr` and `seq` here are fine.

pkt TM_ODD {
  hdr:  8 := 0xAA;

  [ @byte_order: little_endian; ]
  seq:  15;

  tail: 1;
};
