# Bit ordering and byte order at every scope, with the innermost winning.
#
# Read the settings on `count` and `value` together: they sit next to each other, are the same width,
# and are laid out differently. That is the whole point of attaching a group to one field.
#
# The block is the case that group exists for. A run of fields coming out of a little-endian
# subsystem is the commonest reason a frame is not laid out uniformly, and repeating the attribute on
# each of them is how you eventually miss one.

@bit_order:  msb_first;              # file default: applies to every packet below
@byte_order: big_endian;

[ @byte_order: little_endian; ]      # the whole packet
pkt TM_MIXED {
  marker: 16 = 0xCAFE;               # little_endian, from the packet

  [ @byte_order: big_endian; ]       # one field, overriding the packet
  count:  32;

  value:  32;                        # little_endian again

  [ @bit_order: lsb_first; ]         # bit order is independent of byte order
  flags:   4;

  rest:    4;

  [
    @bit_order:  msb_first;          # every field of the block, and nothing after it
    @byte_order: little_endian;
  ]
  block {
    voltage: 32;
    current: 32;
    temp:    16;
  };

  crc: 16;
};
