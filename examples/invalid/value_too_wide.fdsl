// REJECTED: check 8 -- a fixed value must fit in its field's width.
//
// 0xFF needs 8 bits and the field is 4. Truncating silently would produce a frame that does not
// match what the file says, and a decoder built from the same file would then reject it.

pkt TM_OVERFLOW {
  kind: 4 = 0xFF;
  body: 16;
};
