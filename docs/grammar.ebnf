(* Frame-DSL, v1 grammar.
 *
 * ISO/IEC 14977 EBNF. This is the whole language a v1 parser must accept -- deliberately small, and
 * written to be turned directly into a recursive-descent parser: one function per production, no
 * backtracking needed, and every production decidable from a single lookahead token.
 *
 * What is NOT here is as deliberate as what is. Signed and floating-point fields, enums, conditional
 * fields, repetition and CRC declarations are all deferred,
 * each to its own issue, so that they are designed against a language that exists and a parser that
 * runs rather than against a sketch.
 *
 * Rules this grammar cannot express -- a valof() referring only to an earlier field, the mandatory
 * reservation on a variable-sized field, the required discriminator, packet distinguishability, a
 * packet being a whole number of bytes -- are semantic checks, listed in docs/design.md. They are
 * checked when a definition file loads.
 *)

definition_file    = { import } , { attribute } , { packet | named_block | calibration } ;

(* --- Imports --------------------------------------------------------------------------------
 * Blocks and calibrations from another file, flat or under `as name`. The path is relative to the
 * importing file. "import" and "as" are recognised only here, so neither is reserved.
 *)

import             = "import" , string , [ "as" , identifier ] , ";" ;
dotted_name        = identifier , { "." , identifier } ;

(* --- Attributes -----------------------------------------------------------------------------
 * One form per job, so nothing is expressible two ways:
 *
 *   - A bare attribute may appear only before the first packet. It is the file default.
 *   - A group attaches to the declaration that follows it -- a packet, a block or a field -- and
 *     applies to that declaration only.
 *
 * Resolution is innermost-wins: field > block > packet > file.
 *
 * The names are identifiers rather than keywords, and this grammar deliberately does not enumerate
 * them: the parser holds the table, so none of them is reserved and a field may be called
 * `bit_order`. v1 knows `bit_order` (msb_first | lsb_first), `byte_order` (big_endian |
 * little_endian) and `cal` (the name of a calibration, on a field only); an unknown one is reported
 * by name.
 *)

attribute          = "@" , identifier , ":" , identifier , ";" ;
attribute_group    = "[" , attribute , { attribute } , "]" ;

(* --- Packets --------------------------------------------------------------------------------
 * A packet has at least one field: an empty packet describes nothing and is more likely a mistake
 * than an intention. The trailing semicolon after the closing brace is required.
 *)

packet             = [ attribute_group ] , "pkt" , identifier , "{" ,
                       declaration , { declaration } ,
                     "}" , ";" ;

(* --- Declarations ---------------------------------------------------------------------------
 * A block is an attribute scope and nothing else. Its fields are laid out in the packet that
 * contains it, with consecutive offsets and the same flat names they would have had without it, so
 * nothing past the parser knows blocks exist. The *named* form is declared at file level and is
 * composition -- see below.
 *)

declaration        = [ attribute_group ] , ( field | block | use ) ;

block              = "block" , "{" , declaration , { declaration } , "}" , ";" ;

(* --- Named blocks and their uses -----------------------------------------------------------
 * A named block is declared at file level and used as a field whose width is its name. Its fields are
 * copied into the packet under the instance's name (`hdr.id`), with the overrides fixing values. A
 * use's width is a name and a field's never is, so one token after ":" tells them apart. A named
 * block must be declared above every use (check 24); an attribute group in front of a use is an
 * error, because a block's layout is decided where it is declared.
 *)

named_block        = [ attribute_group ] , "block" , identifier , "{" ,
                       declaration , { declaration } ,
                     "}" , ";" ;

use                = identifier , ":" , dotted_name , [ "{" , { override } , "}" ] , ";" ;
override           = identifier , { "." , identifier } , "=" , integer , ";" ;

(* --- Fields ---------------------------------------------------------------------------------
 * Width is an expression in BITS, always. The bracketed reservation is the one number in the
 * language written in BYTES: it sizes the field's arena slot, which is storage rather than layout,
 * and a width that depends on another field has no size until a frame arrives. `=` fixes the
 * field's value and is what lets the decoder tell packets apart.
 *
 * The grammar permits a reservation anywhere, and permits it together with `=`; the semantic pass
 * rejects both. A constant-width field's slot is already known (check 14), and a field whose width
 * is not known until decode time cannot also be a discriminator (check 9).
 *
 * "[" does two jobs -- a group before a declaration, a reservation glued to a name -- told apart by
 * position, with no lookahead, and the two never appear adjacent.
 *)

field              = identifier , [ reservation ] , ":" , width ,
                     [ "=" , integer ] , ";" ;

reservation        = "[" , expression , "]" ;

width              = expression ;

(* --- Expressions ----------------------------------------------------------------------------
 * Integer arithmetic, standard precedence, left-associative. It exists because length fields rarely
 * count exactly what follows them: `valof(len) * 8` when len counts payload bytes,
 * `valof(len) * 8 - 32` when it counts itself as well.
 *)

expression         = term , { ( "+" | "-" ) , term } ;
term               = factor , { ( "*" | "/" ) , factor } ;
factor             = integer
                   | valof
                   | "(" , expression , ")" ;

valof              = "valof" , "(" , identifier , ")" ;

(* --- Calibrations ---------------------------------------------------------------------------
 * A named function from a field's raw value to its engineering value, attached to a field with
 * `@cal: name;`. Arithmetic on doubles. A bare name must be the parameter and a call must name a
 * calibration -- checks 19 and 18 -- so the grammar does not distinguish them.
 *
 * "cal" and "inverse" are not reserved: each is recognised only where it can start a calibration or
 * its inverse, which a single token of lookahead decides. A field may still be called `cal`.
 *)

calibration        = "cal" , identifier , "(" , identifier , ")" , "=" , cal_expression ,
                     [ "inverse" , "(" , identifier , ")" , "=" , cal_expression ] , ";" ;

cal_expression     = cal_term , { ( "+" | "-" ) , cal_term } ;
cal_term           = cal_unary , { ( "*" | "/" ) , cal_unary } ;
cal_unary          = "-" , cal_unary | cal_factor ;
cal_factor         = integer | real
                   | dotted_name , [ "(" , cal_expression , ")" ]
                   | "(" , cal_expression , ")" ;

(* --- Lexical --------------------------------------------------------------------------------
 * Whitespace and comments separate tokens and are otherwise discarded. A comment runs from "#" to
 * the end of the line, and is the only comment form there is: a definition file is short, and one
 * syntax is easier to state than two. It also leaves "/" meaning division and nothing else.
 *)

identifier         = ( letter | "_" ) , { letter | digit | "_" } ;

integer            = decimal | hexadecimal | binary ;
decimal            = digit , { digit } ;
hexadecimal        = "0x" , hex_digit , { hex_digit } ;
binary             = "0b" , bit , { bit } ;

(* Calibrations only. A width or a fixed value written as one is refused with a message saying so. *)
real               = digit , { digit } , ( fraction , [ exponent ] | exponent ) ;
fraction           = "." , digit , { digit } ;
exponent           = ( "e" | "E" ) , [ "+" | "-" ] , digit , { digit } ;

letter             = "A" | "..." | "Z" | "a" | "..." | "z" ;
digit              = "0" | "..." | "9" ;
hex_digit          = digit | "a" | "..." | "f" | "A" | "..." | "F" ;
bit                = "0" | "1" ;

(* An import's path: no escapes, and it closes on the line it opens. *)
string             = '"' , { ? any character except '"' and newline ? } , '"' ;

comment            = "#" , { ? any character except newline ? } , newline ;

(* Reserved words, none of which may be used as an identifier:
 *
 *   pkt  valof  block
 *
 * That is the whole list. Attribute names and values are not among them -- they are meaningful only
 * after "@" and are looked up by the parser, which is why adding an attribute later costs a row in a
 * table rather than a word out of the language.
 *)
